{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Bridge",
  "version": "0.1.5",
  "identifier": "com.pcbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PC Bridge",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../agent/pcbridge_agent/": "agent/pcbridge_agent/",
      "../../agent/pyproject.toml": "agent/pyproject.toml"
    },
    "category": "DeveloperTool",
    "shortDescription": "Send heavy work from your Mac to your PC's GPU",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MDhBMDgzMTRENEE1MDIKUldRQ3BkUVVnNkFJaHZZTmx1aC9UTW1LMGtyV3dncUc1RkJ6K1BEVFR3QUJxVEJ1V3B5MU50NVUK",
      "endpoints": [
        "https://github.com/walidriachy/pc-gpu-bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
